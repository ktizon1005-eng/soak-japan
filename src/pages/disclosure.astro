---
import { SITE_TITLE } from '../consts';
import Layout from '../layouts/Page.astro';
---

<Layout title="Affiliate Disclosure" description={`How ${SITE_TITLE} earns money from links.`}>
	<p>
		{SITE_TITLE} takes part in affiliate programmes run by travel booking sites. When you click one of
		these links and make a booking, the booking site may pay us a commission. The price you pay is the
		same.
	</p>
	<p>
		Affiliate links are marked with “(affiliate link)” or appear in a box labelled as a booking link.
		We only recommend places based on the facts in the guide, and we never accept payment to change a
		recommendation.
	</p>
</Layout>
